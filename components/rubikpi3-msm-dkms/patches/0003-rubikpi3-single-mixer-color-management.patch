--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -10,6 +10,7 @@
 #include <linux/sort.h>
 #include <linux/debugfs.h>
 #include <linux/ktime.h>
+#include <linux/of.h>
 #include <linux/bits.h>
 
 #include <drm/drm_atomic.h>
@@ -1416,6 +1417,20 @@
 	else
 		topology.num_lm = 1;
 
+	/*
+	 * RubikPi3's SC7280 has one DSPP, attached to the unpaired LM0.
+	 * The LM2/LM3 pair has no DSPPs, so the usual split above 1080
+	 * pixels cannot satisfy CTM or gamma requests. Keep this board's
+	 * single-interface, uncompressed output on one mixer whenever it
+	 * fits, even without color properties, so blank/unblank does not
+	 * switch between incompatible mixer topologies.
+	 */
+	if (of_machine_is_compatible("thundercomm,rubikpi3") &&
+	    topology.num_intf == 1 && !topology.num_dsc &&
+	    !topology.cwb_enabled &&
+	    mode->hdisplay <= dpu_kms->catalog->caps->max_mixer_width)
+		topology.num_lm = 1;
+
 	if (crtc_state->ctm || crtc_state->gamma_lut)
 		topology.num_dspp = topology.num_lm;
 
