#!/bin/sh
set -eu
case "${1:-}" in prereqs) exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
# display_connector is a DT graph dependency, not an ELF module dependency.
for module in msm lontium_lt9611 display_connector dispcc_sc7280 xhci_pci_renesas; do
    manual_add_modules "$module"
done
copy_file firmware /usr/lib/firmware/renesas_usb_fw.mem
